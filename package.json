{
  "name": "buildly-react-template",
  "version": "1.0.0",
  "description": "Frontend Template from Buildly built using the React framework",
  "main": "src/index.js",
  "private": true,
  "workspaces": [
    "src/clients/*"
  ],
  "dependencies": {
    "@babel/plugin-transform-class-properties": "^7.25.9",
    "@babel/plugin-transform-private-methods": "^7.25.9",
    "@babel/plugin-transform-runtime": "^7.25.9",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.1.9",
    "@mui/lab": "^6.0.0-beta.16",
    "@mui/material": "^6.1.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "i18next": "^23.10.1",
    "i18next-browser-languagedetector": "^8.0.2",
    "mui-datatables": "^4.3.0",
    "npm": "^10.9.2",
    "path": "^0.12.7",
    "polished": "^4.3.1",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.15",
    "react-refresh": "^0.14.2",
    "react-i18next": "^15.1.4",
    "@tanstack/react-query": "^5.62.2",
    "@tanstack/react-query-devtools": "^5.62.2",
    "react-router-dom": "^6.30.0",
    "serve": "^14.2.4",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/cli": "^7.25.9",
    "@babel/core": "^7.26.0",
    "@babel/plugin-transform-class-properties": "^7.25.9",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.25.9",
    "@types/jest": "^29.5.14",
    "awesome-typescript-loader": "^5.2.1",
    "axios": "^1.8.3",
    "axios-cancel": "^0.2.2",
    "babel-core": "^7.0.0-bridge.0",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.2.1",
    "core-js": "^3.39.0",
    "regenerator-runtime": "^0.14.1",
    "babel-preset-es2015": "^6.24.1",
    "babel-preset-react": "^6.24.1",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "@testing-library/react": "^16.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.5.2",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-import-resolver-webpack": "^0.13.9",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "file-loader": "^6.2.0",
    "file-replace-loader": "^1.4.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.3",
    "image-webpack-loader": "^8.1.0",
    "jest": "^29.7.0",
    "pngquant": "^4.2.0",
    "react-docgen": "^7.1.0",
    "react-docgen-typescript": "^2.2.2",
    "rxjs": "^7.8.2",
    "sass": "^1.83.0",
    "sass-loader": "^16.0.3",
    "source-map-loader": "^5.0.0",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.2.5",
    "typedoc": "^0.25.13",
    "typescript": "^4.9.5",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  },
  "resolutions": {
    "@babel/core": "^7.26.0",
    "@babel/generator": "^7.26.0",
    "@babel/compat-data": "^7.26.0",
    "@babel/helper-compilation-targets": "^7.25.9",
    "@babel/helper-create-class-features-plugin": "^7.25.9",
    "@babel/helper-module-transforms": "^7.26.0",
    "babel-loader": "^9.2.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1"
  },
  "scripts": {
    "build": "webpack --mode development",
    "start:local": "webpack-dev-server --mode development --env build=local",
    "https:local": "webpack-dev-server --mode development --env build=local --server-type https --server-options-cert ~/.localhost-ssl/localhost.pem --server-options-key ~/.localhost-ssl/localhost-key.pem",
    "build:dev": "webpack --mode development --env build=dev",
    "start:dev": "webpack-dev-server --mode development --env build=dev",
    "build:prod": "webpack --mode production --env build=prod",
    "start:prod": "webpack-dev-server --mode development --env build=prod",
    "test": "jest --watch",
    "test:prod": "jest",
    "test-coverage": "jest --updateSnapshot --coverage",
    "serve": "./node_modules/.bin/serve -s dist",
    "lint": "eslint src/**/*.js"
  },
  "jest": {
    "moduleNameMapper": {
      "\\.(css|less|scss)$": "<rootDir>/__mocks__/styleMock.js",
      "\\.(gif|ttf|eot|svg|png|jpg)$": "<rootDir>/__mocks__/fileMock.js"
    },
    "moduleDirectories": [
      "node_modules",
      "<rootDir>/src",
      "src",
      "<rootDir>/src/styles",
      "<rootDir>"
    ],
    "moduleFileExtensions": [
      "js",
      "jsx",
      "ts",
      "tsx"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest",
      "\\.(js|jsx)?$": "./test-transform.js"
    },
    "setupFiles": [
      "<rootDir>/test-setup.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,tsx}"
    ],
    "snapshotSerializers": [
      "enzyme-to-json/serializer"
    ]
  },
  "keywords": [
    "Buildly",
    "React"
  ],
  "author": "Buildly",
  "license": "ISC"
}
